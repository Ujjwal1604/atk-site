---
layout: base.njk
title: Alumni
---

<style>

</style>

{# <h2 class="mb-4">Alumni</h2> #}

<!-- Navigation Pills -->
<ul class="nav nav-pills mb-4 flex-wrap" id="alumniTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="phd-tab" data-bs-toggle="pill" data-bs-target="#phd" type="button" role="tab">
            PhD Students <span class="badge bg-secondary count-badge">{{ alumni_phd.length }}</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="postdoc-tab" data-bs-toggle="pill" data-bs-target="#postdoc" type="button" role="tab">
            Post Doctoral <span class="badge bg-secondary count-badge">{{ alumni_post_doc.length }}</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="joint-phd-tab" data-bs-toggle="pill" data-bs-target="#joint-phd" type="button" role="tab">
            Joint PhD <span class="badge bg-secondary count-badge">{{ alumni_joint_phd.length }}</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pg-projects-tab" data-bs-toggle="pill" data-bs-target="#pg-projects" type="button" role="tab">
            PG Projects <span class="badge bg-secondary count-badge">{{ projects_pg.length }}</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="btech-projects-tab" data-bs-toggle="pill" data-bs-target="#btech-projects" type="button" role="tab">
            B.Tech Projects <span class="badge bg-secondary count-badge">{{ projects_btech.length }}</span>
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="alumniTabContent">
    
    <!-- PhD Students Tab -->
    <div class="tab-pane fade show active" id="phd" role="tabpanel">
        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="phd-search" placeholder="Search PhD students by name, position, or thesis title...">
            </div>
        </div>
        
        <div id="phd-results">
            {% for alumnus in alumni_phd %}
            <div class="card overflow-hidden shadow-sm mb-4" data-searchable="{{ alumnus.name | lower }} {{ alumnus.position | lower }} {{ alumnus.thesis | lower }}">
                <div class="row g-0 align-items-center">
                    <div class="col-md-3 {% if loop.index is odd %}order-md-2{% endif %} d-flex align-items-center justify-content-center p-3">
                        <img src="{{ alumnus.image | url }}" class="rounded-circle" alt="Photo of {{ alumnus.name }}" width="180" height="180">
                    </div>
                    <div class="col-md-9 {% if loop.index is odd %}order-md-1{% endif %}">
                        <div class="card-body">
                            <h4 class="card-title">{{ loop.index }}. {{ alumnus.name }}</h4>
                            <h6 class="card-subtitle mb-3 text-muted">{{ alumnus.position }}</h6>
                            <p class="card-text"><strong>Thesis Title:</strong> {{ alumnus.thesis | safe }}</p>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <div id="phd-no-results" class="no-results d-none">
            <h4>No results found</h4>
            <p class="mb-0">Try adjusting your search terms</p>
        </div>
    </div>

    <!-- Post Doctoral Tab -->
    <div class="tab-pane fade" id="postdoc" role="tabpanel">
        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="postdoc-search" placeholder="Search post doctoral students by name or position...">
            </div>
        </div>
        
        <div id="postdoc-results">
            {% for alumnus in alumni_post_doc %}
            <div class="card overflow-hidden shadow-sm mb-4" data-searchable="{{ alumnus.name | lower }} {{ alumnus.position | lower }}">
                <div class="row g-0 align-items-center">
                    <div class="col-md-3 {% if loop.index is odd %}order-md-2{% endif %} d-flex align-items-center justify-content-center p-3">
                        <img src="{{ alumnus.image | url }}" class="rounded-circle" alt="Photo of {{ alumnus.name }}" width="180" height="180">
                    </div>
                    <div class="col-md-9 {% if loop.index is odd %}order-md-1{% endif %}">
                        <div class="card-body">
                            <h4 class="card-title">{{ loop.index }}. {{ alumnus.name }}</h4>
                            <h6 class="card-subtitle mb-3 text-muted">{{ alumnus.position }}</h6>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <div id="postdoc-no-results" class="no-results d-none">
            <h4>No results found</h4>
            <p class="mb-0">Try adjusting your search terms</p>
        </div>
    </div>

    <!-- Joint PhD Tab -->
    <div class="tab-pane fade" id="joint-phd" role="tabpanel">
        <h3 class="mb-3">PhD students who completed their PhD Degree under Joint Supervision from Visva-Bharati, Central University, West Bengal</h3>
        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="joint-phd-search" placeholder="Search joint PhD students...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover project-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Title of the Thesis (Degree Awarded Year)</th>
                        <th>Present Position</th>
                    </tr>
                </thead>
                <tbody id="joint-phd-tbody">
                    {% for project in alumni_joint_phd %}
                    <tr data-searchable="{{ project.name | lower }} {{ project.thesis | lower }} {{ project.position | lower }}">
                        <td>{{ project.name }}</td>
                        <td>{{ project.thesis | safe }}</td>
                        <td>{{ project.position }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div id="joint-phd-no-results" class="no-results d-none">
            <h4>No results found</h4>
            <p class="mb-0">Try adjusting your search terms</p>
        </div>
    </div>

    <!-- PG Projects Tab -->
    <div class="tab-pane fade" id="pg-projects" role="tabpanel">
        <h3 class="mb-3">PG Projects Guided</h3>
        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="pg-search" placeholder="Search PG projects by name, roll no, title, or year...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover project-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Roll No.</th>
                        <th>Project Title</th>
                        <th>Year</th>
                    </tr>
                </thead>
                <tbody id="pg-tbody">
                    {% for project in projects_pg %}
                    <tr data-searchable="{{ project.name | lower }} {{ project.roll_no | lower }} {{ project.title | lower }} {{ project.year }}">
                        <td>{{ project.name }}</td>
                        <td>{{ project.roll_no }}</td>
                        <td>{{ project.title | safe }}</td>
                        <td>{{ project.year }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div id="pg-no-results" class="no-results d-none">
            <h4>No results found</h4>
            <p class="mb-0">Try adjusting your search terms</p>
        </div>
    </div>

    <!-- B.Tech Projects Tab -->
    <div class="tab-pane fade" id="btech-projects" role="tabpanel">
        <h3 class="mb-3">B.Tech Projects Guided</h3>
        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="btech-search" placeholder="Search B.Tech projects by name, roll no, title, or year...">
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover project-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Roll No.</th>
                        <th>Project Title</th>
                        <th>Year</th>
                    </tr>
                </thead>
                <tbody id="btech-tbody">
                    {% for project in projects_btech %}
                    <tr data-searchable="{{ project.name | lower }} {{ project.roll_no | lower }} {{ project.title | lower }} {{ project.year }}">
                        <td>{{ project.name }}</td>
                        <td>{{ project.roll_no }}</td>
                        <td>{{ project.title | safe }}</td>
                        <td>{{ project.year }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div id="btech-no-results" class="no-results d-none">
            <h4>No results found</h4>
            <p class="mb-0">Try adjusting your search terms</p>
        </div>
    </div>
</div>
